fn fizzbuzz(count: Int) -> Void do
    for i in 1..=count do
        printed: Bool = false
        if i % 3 == 0 then
            stdout("Fizz")
            printed = true
        end
        if i % 5 == 0 then
            stdout("Buzz")
            printed = true
        end
        if not printed then
            stdout(itoa(i))
        end
        stdout("\n")
    end
end

fizzbuzz(15)
