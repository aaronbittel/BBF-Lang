global _start

_start:
    ; init base pointer
    push rbp
    mov rbp, rsp
    
    ; assign(x = 4 + 5)
    mov rax, 5
    push rax ; save RHS on stack
    mov rax, 4
    pop rbx ; restore RHS into rbx
    add rax, rbx
    push rax
    
    ; default exit 0
    mov rdi, 0
    call __builtin_exit
    
; BUILTIN FUNCTIONS
__builtin_exit:
    mov rax, 60
    syscall