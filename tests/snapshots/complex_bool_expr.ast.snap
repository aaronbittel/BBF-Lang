fn print(str: String, expr: Bool) -> Void do
    stdout( str )
    stdout( ': ' )
    stdout( btoa( expr ) )
    stdout( '\n' )
end
print( '(true or false) and false', ( (( true or false )) and false ) )
print( 'true or (false and false)', ( true or (( false and false )) ) )
print( '(false or false) and (true or false)', ( (( false or false )) and (( true or false )) ) )
print( '(true and true) or (false and true)', ( (( true and true )) or (( false and true )) ) )
stdout( '======================\n' )
print( 'true and true and false', ( ( true and true ) and false ) )
print( 'false or false or true', ( ( false or false ) or true ) )
print( 'true or false or false and true', ( ( true or false ) or ( false and true ) ) )
print( '(true or false) and (false or true)', ( (( true or false )) and (( false or true )) ) )
stdout( '======================\n' )
print( 'not false and true', ( notfalse and true ) )
print( 'not (true or false)', not(( true or false )) )
print( 'not true or false and true', ( nottrue or ( false and true ) ) )
print( 'not (false and true) or true', ( not(( false and true )) or true ) )
