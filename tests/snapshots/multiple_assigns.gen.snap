global _start

_start:
    ; init base pointer
    push rbp
    mov rbp, rsp
    
    ; assign(x = 12)
    push 12; pushing 12
    
    ; assign(y = x)
    push QWORD [rbp-8] ; push value from variable x
    
    ; assign(z = x)
    push QWORD [rbp-8] ; push value from variable x
    
    ; assign(z = ( y + 1 ))
    push QWORD [rbp-16] ; push value from variable y
    push 1; pushing 1
    pop rbx; pop rhs ?
    pop rax; pop lhs ?
    ; addition
    add rax, rbx
    push rax; push result
    mov [rbp-24], rax
    
    ; exit(z)
    push QWORD [rbp-24] ; push value from variable z
    pop rdi
    call __builtin_exit
    
    ; default exit 0
    mov rdi, 0
    call __builtin_exit
    
; BUILTIN FUNCTIONS
__builtin_exit:
    mov rax, 60
    syscall