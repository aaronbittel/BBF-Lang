global _start

_start:
    ; init base pointer
    push rbp
    mov rbp, rsp
    
    ; assign(x = ( 30 / 5 ))
    push 30; pushing 30
    push 5; pushing 5
    pop rbx; pop rhs ?
    pop rax; pop lhs ?
    ; division
    xor rdx, rdx ; clear upper 64bit of 128 bit division
    div rbx
    push rax; push result
    
    ; exit(x)
    push QWORD [rbp-8] ; push value from variable x
    pop rdi
    call __builtin_exit
    
    ; default exit 0
    mov rdi, 0
    call __builtin_exit
    
; BUILTIN FUNCTIONS
__builtin_exit:
    mov rax, 60
    syscall