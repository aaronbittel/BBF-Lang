global _start

_start:
    ; init base pointer
    push rbp
    mov rbp, rsp
    
    ; assign(x = 5 + 1 + 3)
    mov rax, 3
    push rax ; save RHS on stack
    mov rax, 1
    pop rbx ; restore RHS into rbx
    add rax, rbx
    push rax ; save RHS on stack
    mov rax, 5
    pop rbx ; restore RHS into rbx
    add rax, rbx
    push rax
    
    ; exit(x)
    mov rax, [rbp-8] ; retrieve value from variable x
    mov rdi, rax
    call __builtin_exit
    
    ; default exit 0
    mov rdi, 0
    call __builtin_exit
    
; BUILTIN FUNCTIONS
__builtin_exit:
    mov rax, 60
    syscall