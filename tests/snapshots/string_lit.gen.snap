global _start

_start:
    ; init base pointer
    push rbp
    mov rbp, rsp

    ; assign(x = "Hello, World!")
    ; load string literal
    lea rax, [s_lit_00]
    push rax

    ; default exit 0
    mov rdi, 0
    call __builtin_exit

; BUILTIN FUNCTIONS
__builtin_exit:
    mov rax, 60
    syscall

; STATIC SECTION
section .data
s_lit_00: db "Hello, World!"
s_lit_00_len: equ $ s_lit_00
