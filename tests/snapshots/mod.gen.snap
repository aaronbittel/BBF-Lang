global _start

_start:
    ; init base pointer
    push rbp
    mov rbp, rsp
    
    ; assign(x = ( 32 % 5 ))
    push 32; pushing 32
    push 5; pushing 5
    pop rbx; pop rhs ?
    pop rax; pop lhs ?
    ; modulo
    xor rdx, rdx ; clear upper 64bit of 128 bit division
    div rbx
    push rdx; push result (remainder always in rdx)
    
    ; exit(x)
    push QWORD [rbp-8] ; push value from variable x
    pop rdi
    call __builtin_exit
    
    ; default exit 0
    mov rdi, 0
    call __builtin_exit
    
; BUILTIN FUNCTIONS
__builtin_exit:
    mov rax, 60
    syscall